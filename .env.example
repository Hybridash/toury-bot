DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: only needed for `npm run deploy:commands -- --guild` (instant commands in one test server)
DISCORD_GUILD_ID=
DATABASE_PATH=./data/tournament.sqlite

# Optional: members with this role count as tournament staff (Administrator / Manage Server always do)
STAFF_ROLE_ID=
# Optional: channel where team + tournament activity gets logged
LOG_CHANNEL_ID=

# ---- Orion Drift (bans, arenas, auto-whitelist) ----
# API key with: user_data:read, user_ban:write, user_ban:revoke, user_roles:write, role:read, role:write, fleet:read
ORION_API_KEY=
# Main fleet for /ban, /unban, /banlist (bans also apply to every arena fleet you add)
ORION_FLEET_ID=
ORION_API_BASE_URL=

# Station whose gamemode slots (Alpha 01 ... Gamma 03) are the arenas
ORION_STATION_ID=

# Website API (read-only). Give this key to the website dev; send it as the x-api-key header.
API_KEY=
API_PORT=

# Website key WITHOUT Discord IDs/timezones (give THIS one to the website dev). Add ":pii" to a key to include them.
API_KEYS=
